   "source": [
    "## Unwarp phase"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ce2849db",
   "metadata": {},
   "outputs": [],
   "source": [
    "def unwrap_phase(phase_list):\n",
    "    \"\"\"Thực hiện unwrap pha cho từng packet.\"\"\"\n",
    "    return [np.unwrap(p) if len(p) > 0 else p for p in phase_list]\n",
    "\n",
    "# Áp dụng cho dữ liệu\n",
    "print(\"Đang thực hiện Phase Unwrapping...\")\n",
    "df_calc[\"phase_unwrapped\"] = unwrap_phase(df_calc[\"phase\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b852aa2d",
   "metadata": {},
   "source": [
    "## Phase Sanitization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "68c7f0a7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sanitize_phase_robust(phase_array):\n",
    "    \"\"\"\n",
    "    Loại bỏ lỗi pha tuyến tính (Linear Phase Offset) do SFO/CFO.\n",
    "    Sử dụng Linear Regression trên các subcarrier có giá trị.\n",
    "    \"\"\"\n",
    "    if len(phase_array) == 0:\n",
    "        return phase_array\n",
    "    \n",
    "    # Chỉ lấy các subcarrier có pha khác 0 (tránh guard subcarriers / DC)\n",
    "    valid_idx = np.where(np.abs(phase_array) > 1e-6)[0]\n",
    "    if len(valid_idx) < 2:\n",
    "        return phase_array\n",
    "        \n",
    "    x = valid_idx\n",
    "    y = phase_array[valid_idx]\n",
    "    \n",
    "    # Linear fit: y = ax + b\n",
    "    a, b = np.polyfit(x, y, 1)\n",
    "    \n",
    "    sanitized = phase_array.copy()\n",
    "    sanitized[valid_idx] = y - (a * x + b)\n",
    "    return sanitized\n",
    "\n",
    "print(\"Đang thực hiện Phase Sanitization...\")\n",
    "df_calc[\"phase_sanitized\"] = df_calc[\"phase_unwrapped\"].apply(sanitize_phase_robust)"
   ]
  },
